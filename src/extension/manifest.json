{
  "manifest_version": 3,
  "name": "Artemis Quiver",
  "version": "3.8.0",
  "description": "Import job postings into Artemis Quiver and get AI-powered match scoring",
  "permissions": ["scripting", "storage", "activeTab", "sidePanel"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Artemis Quiver Config"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["nano-inject.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
