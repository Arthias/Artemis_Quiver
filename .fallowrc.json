{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/main.tsx",
    "src/extension/background.ts",
    "src/extension/overlay.ts",
    "src/extension/nano-inject.ts",
    "src/extension/popup.tsx"
  ],
  "ignorePatterns": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "off"
  }
}
